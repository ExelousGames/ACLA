{
  "_skill": {
    "name": "lap_annotation"
  },
  "behavior_parent_label_ids": {
    "required": ["O", "OD", "PS", "RM", "MSP", "MSR","EA"],
    "eligible_by_session": {
      "practice": ["EA","PS", "RM", "MSP", "Segment Type"],
      "racing": ["O", "OD", "MSR", "PS", "Segment Type"]
    }
  },
  "labels": {
    "EA": {
      "name": "Expert Adherence (Training)",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.EA",
      "exclusive_with": ["MSP", "MSR", "RM", "PS"]
    },
    "MSP": {
      "name": "Mistake (Practice)",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.MSP",
      "exclusive_with": ["EA", "PS", "MSR"]
    },
    "MSR": {
      "name": "Mistake (Racing)",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.MSR",
      "exclusive_with": ["EA", "PS", "MSP"]
    },
    "RM": {
      "name": "Recovery & Merge",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.RM",
      "exclusive_with": ["EA", "PS"]
    },
    "PS": {
      "name": "Pit Stop",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.PS",
      "exclusive_with": ["O"]
    },
    "O": {
      "name": "Successful Overtake",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.O",
      "exclusive_with": ["OD", "PS"]
    },
    "OD": {
      "name": "Successful Defense",
      "type": "main",
      "parent": null,
      "selection_requirements_ref": "lap_annotation.selection_requirements.OD",
      "exclusive_with": ["O", "PS"]
    }
  },
  "selection_requirements": {
    "EA": {
      "enabled": true,
      "any_of": [
        {"all_of": [
          {"fact": "time_gap.total_change_abs_ms", "operator": "lt", "value": 50},
          {"fact": "time_gap.ending_direction", "operator": "eq", "value": "falling"}
        ]},
        {"all_of": [
          {"fact": "time_gap.total_change_abs_ms", "operator": "gte", "value": 50},
          {"fact": "time_gap.has_significant_rise", "operator": "eq", "value": false},
          {"fact": "brake.similarity", "operator": "eq", "value": 1.0},
          {"fact": "throttle.similarity", "operator": "eq", "value": 1.0}
        ]}
      ]
    },
    "MSP": {
      "enabled": true,
      "any_of": [
        {"all_of": [
          {"fact": "time_gap.has_significant_rise", "operator": "eq", "value": true}
        ]}
      ]
    },
    "MSR": {"enabled": true, "any_of": [{"all_of": [
      {"fact": "opponent.outcome", "operator": "in", "value": ["failed_attack", "broken_defense"]},
      {"fact": "opponent.confidence_level", "operator": "in", "value": ["medium", "high"]}
    ]}]},
    "RM": {
      "enabled": true,
      "any_of": [
        {"all_of": [
          {"fact": "time_gap.starting_direction", "operator": "eq", "value": "rising"},
          {"fact": "time_gap.middle_has_new_significant_rise", "operator": "eq", "value": false},
          {"fact": "time_gap.flattening_at_end", "operator": "eq", "value": true}
        ]}
      ]
    },
    "PS": {"enabled": true, "any_of": [
      {"all_of": [
        {"fact": "section.overlap_names", "operator": "contains", "value": "Pit"},
        {"fact": "trajectory.peak_abs_offset_m", "operator": "gt", "value": 3.0},
        {"fact": "speed.expert_faster", "operator": "eq", "value": true},
        {"fact": "speed.gap_peak_abs_kmh", "operator": "gt", "value": 50}
      ]},
      {"all_of": [
        {"fact": "section.overlap_names", "operator": "contains", "value": "Pit"},
        {"fact": "trajectory.peak_abs_offset_m", "operator": "gte", "value": 10.0}
      ]}
    ]},
    "O": {"enabled": true, "any_of": [{"all_of": [
      {"fact": "opponent.outcome", "operator": "eq", "value": "pass_completed"},
      {"fact": "opponent.confidence_level", "operator": "in", "value": ["medium", "high"]}
    ]}]},
    "OD": {"enabled": true, "any_of": [{"all_of": [
      {"fact": "opponent.outcome", "operator": "eq", "value": "held_defense"},
      {"fact": "opponent.confidence_level", "operator": "in", "value": ["medium", "high"]}
    ]}]}
  }
}
