[importlinter]
root_package = app

# The local annotation/training package lives in ../acla_ai_training.
# Runtime modules must not import it (covered by test_runtime_service_boundary).

# ─── Leaves ───────────────────────────────────────────────────────────────────

[importlinter:contract:features-is-leaf]
name = app/features is a leaf (stateless math)
type = forbidden
source_modules =
    app.features
forbidden_modules =
    app.api
    app.startup
    app.racing_engineer
    app.voice
    app.ml
    app.integrations

[importlinter:contract:infra-is-leaf]
name = app/infra (config) imports nothing from app
type = forbidden
source_modules =
    app.infra
forbidden_modules =
    app.api
    app.startup
    app.racing_engineer
    app.shared
    app.voice
    app.ml
    app.integrations
    app.features
    app.internal_knowledge_base
    app.external_knowledge_base

[importlinter:contract:knowledge-bases-only-touch-shared]
name = knowledge bases only reach down to shared/infra
type = forbidden
source_modules =
    app.internal_knowledge_base
    app.external_knowledge_base
forbidden_modules =
    app.api
    app.startup
    app.racing_engineer
    app.voice
    app.ml
    app.integrations
    app.features

# ─── Outbound adapters / capabilities: never reach up into orchestration or api ─

[importlinter:contract:adapters-no-upward]
name = LLM/voice/ml/integrations adapters never import orchestration, api, or startup
type = forbidden
source_modules =
    app.voice
    app.ml
    app.integrations
    app.shared
forbidden_modules =
    app.api
    app.startup
    app.racing_engineer

# ─── Racing engineer: never reach into api or startup ─────────────────────────

[importlinter:contract:racing-engineer-no-api-startup]
name = racing_engineer never imports api or startup
type = forbidden
source_modules =
    app.racing_engineer
forbidden_modules =
    app.api
    app.startup

# ─── API: thin inbound adapter ────────────────────────────────────────────────

[importlinter:contract:api-stays-thin]
name = app/api never imports startup (api is reached FROM startup, not the reverse)
type = forbidden
source_modules =
    app.api
forbidden_modules =
    app.startup
