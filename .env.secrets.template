# Template for environment secrets
# Copy this file to .env.secrets and fill in your actual values
# DO NOT commit .env.secrets to version control

# Chat LLM selection.
# Default = OpenAI via CHAT_LLM_MODEL=openai:gpt-5.5.
# OPENAI_API_KEY=your_openai_api_key_here
# To use a hosted OpenAI-compatible endpoint (Groq, Cerebras, Together,
# Fireworks, OpenRouter, ...), set CHAT_LLM_MODEL to hosted:<model> and
# uncomment the hosted endpoint credentials.
# CHAT_LLM_MODEL=hosted:qwen/qwen3-32b
# HOSTED_LLM_BASE_URL=https://api.groq.com/openai/v1
# HOSTED_LLM_API_KEY=your_hosted_llm_api_key_here

# AI annotation providers.
# Setting OPENAI_API_KEY makes the "OpenAI / ChatGPT" annotation provider
# appear in the Streamlit annotation UI. To force a provider list, set e.g.
# ANNOTATION_ENABLED_PROVIDERS=claude_cli,openai

# Hugging Face Configuration
HF_TOKEN=your_hf_token_here
HF_USERNAME=your_hf_username_here

# Admin account (created at backend startup if it doesn't exist)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# AI Service account (created at backend startup if it doesn't exist)
AI_SERVICE_USERNAME=your_ai_service_username
AI_SERVICE_PASSWORD=your_ai_service_password
